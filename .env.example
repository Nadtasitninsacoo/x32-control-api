# ---------------------------------------------------------------------------
# x32-control-api — copy to .env and adjust. Every variable has a safe default
# except X32_HOST, which may also be left empty and discovered on the network.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Console link -----------------------------------------------------------
# IP of the X32/M32. Leave empty to rely on discovery (POST /consoles/discover).
X32_HOST=192.168.1.10
X32_PORT=10023

# Local UDP port to bind. 0 = let the OS choose (recommended).
OSC_LOCAL_PORT=0

# Broadcast address used by the /info discovery sweep.
OSC_BROADCAST_ADDRESS=255.255.255.255

# --- Pacing (do not raise without measuring; the console drops packets) ------
OSC_MAX_MSG_PER_SEC=50
OSC_MIN_GAP_MS=2
OSC_MAX_QUEUE_LENGTH=5000
OSC_REQUEST_TIMEOUT_MS=1000

# /xremote expires after 10s on the console; renew comfortably before that.
XREMOTE_INTERVAL_MS=8000

# --- Safety -----------------------------------------------------------------
# true = state-changing OSC is logged instead of sent. Queries still work.
DRY_RUN=false

# --- Console link supervision -----------------------------------------------
# Connect to X32_HOST at boot (when one is set).
CONSOLE_AUTO_CONNECT=true

# Liveness: a probe every 2s, 2 misses = link lost. Detection ~4-6s.
CONSOLE_PROBE_INTERVAL_MS=2000
CONSOLE_PROBE_TIMEOUT_MS=1000
CONSOLE_MAX_MISSED_PROBES=2

# Reconnect backoff. The ceiling stays low so a console that comes back is
# picked up within seconds — together with detection this meets the
# "reconnect within 10s" requirement.
CONSOLE_RECONNECT_MIN_MS=500
CONSOLE_RECONNECT_MAX_MS=5000

# How much of the console to mirror at connect time: surface | sends | full.
# The link is usable after the surface stage; the rest streams in behind it.
CONSOLE_SYNC_DEPTH=full

# How long a discovery sweep listens for answers.
DISCOVERY_TIMEOUT_MS=1500

# --- Metering ---------------------------------------------------------------
# Frames per second pushed over WebSocket. Frames are coalesced, never queued.
METER_FPS=20

# Meter subscriptions expire after 10s on the console; renew well inside that.
METER_RENEW_MS=5000

# Console-side meter rate divider; 1 is roughly one update every 50ms.
METER_TIME_FACTOR=1

# --- Applying presets and scenes --------------------------------------------
# Level changes are walked to their target instead of jumping, which is what
# stops a preset recall from clicking. Requests outside the window are clamped.
RAMP_DEFAULT_MS=400
RAMP_MIN_MS=300
RAMP_MAX_MS=800

# --- Storage ----------------------------------------------------------------
# PostgreSQL for venue presets. Leave it empty and presets are kept in memory:
# everything works, nothing survives a restart, and the log says so at boot.
# docker compose sets this for you.
DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# false means no token is needed and every request runs as an administrator.
# Reasonable on a closed show network, not on a shared one. The API says which
# it is doing at boot.
AUTH_ENABLED=false

# Required once AUTH_ENABLED is true. Use something long and random.
JWT_SECRET=

JWT_EXPIRES_IN_SECONDS=43200

# Creates the first administrator when authentication is on and none exist.
# Clear these once that account has a password of its own.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=

# --- Safety -----------------------------------------------------------------
# Start in read-only mode: reads work, writes are refused with 423 Locked.
# Can be flipped at runtime via POST /api/safety/read-only, no restart needed.
READ_ONLY=false
